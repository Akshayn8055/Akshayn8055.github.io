---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Carousel from '../../components/Carousel.astro';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const p = entry.data;

function youtubeEmbed(idOrUrl: string, start?: number) {
  const idMatch = idOrUrl.match(/(?:v=|youtu\.be\/)([\w-]{11})/);
  const id = idMatch ? idMatch[1] : idOrUrl;
  const params = start ? `?start=${start}` : '';
  return `https://www.youtube.com/embed/${id}${params}`;
}
---

<BaseLayout title={p.title} description={p.tagline}>
  <article class="section detail">
    <a class="back mono" href="/#projects">← All projects</a>

    <header class="head">
      <p class="kicker">{p.dateRange}{p.role && ` · ${p.role}`}</p>
      <h1>{p.title}</h1>
      <p class="tagline">{p.tagline}</p>
      <div class="tags">{p.tags.map((t: string) => <span>{t}</span>)}</div>
      {(p.links.github || p.links.report) && (
        <div class="links">
          {p.links.github && (
            <a class="btn btn-ghost" href={p.links.github} target="_blank" rel="noopener">GitHub repo ↗</a>
          )}
          {p.links.report && (
            <a class="btn btn-solid" href={p.links.report} target="_blank" rel="noopener">Design report (PDF)</a>
          )}
        </div>
      )}
    </header>

    {p.demoVideo ? (
      <div class="media">
        {p.demoVideo.type === 'youtube' ? (
          <iframe
            src={youtubeEmbed(p.demoVideo.src, p.demoVideo.start)}
            title={`${p.title} demo video`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        ) : (
          <video src={p.demoVideo.src} poster={p.coverImage} controls playsinline></video>
        )}
      </div>
    ) : p.highlightVideo ? (
      <div class="media">
        <video src={p.highlightVideo} poster={p.coverImage} muted loop autoplay playsinline controls></video>
      </div>
    ) : p.coverImage ? (
      <div class="media"><img src={p.coverImage} alt={p.title} /></div>
    ) : null}

    <div class="layout">
      <div class="content">
        <Content />
      </div>
      {p.stack.length > 0 && (
        <aside class="stack">
          <h4>Built with</h4>
          <ul>{p.stack.map((s: string) => <li>{s}</li>)}</ul>
        </aside>
      )}
    </div>

    {p.gallery.length > 0 && (
      <div class="gallery">
        <p class="kicker">Gallery</p>
        <Carousel slides={p.gallery} />
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .detail { max-width: 980px; padding-top: 130px; }
  .back { display: inline-block; font-size: 0.82rem; color: var(--muted); margin-bottom: 2rem; }
  .back:hover { color: var(--accent); }
  .head .kicker { margin-bottom: 14px; }
  .head h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.06; letter-spacing: -0.025em; }
  .tagline { color: var(--muted); font-size: 1.15rem; margin: 18px 0 16px; max-width: 720px; }
  .links { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 26px; }

  .media { margin-top: 48px; }
  .media iframe,
  .media video,
  .media img { width: 100%; aspect-ratio: 16/9; border: 0; border-radius: var(--radius); background: #000; object-fit: cover; }

  .layout { display: grid; grid-template-columns: 1fr 240px; gap: 56px; margin-top: 56px; align-items: start; }
  .content :global(h2) { font-size: 1.5rem; letter-spacing: -0.01em; margin: 40px 0 14px; }
  .content :global(h2:first-child) { margin-top: 0; }
  .content :global(p) { color: var(--muted); font-size: 1.04rem; margin: 0 0 16px; max-width: 68ch; }
  .content :global(strong) { color: var(--text); font-weight: 600; }
  .content :global(ul) { color: var(--muted); padding-left: 1.2rem; margin: 0 0 16px; }
  .content :global(li) { margin-bottom: 10px; }
  .content :global(li::marker) { color: var(--accent); }

  .stack { position: sticky; top: 100px; padding-top: 18px; border-top: 1px solid var(--line); }
  .stack h4 { display: flex; align-items: center; gap: 10px; font-size: 1rem; font-weight: 600; margin-bottom: 12px; }
  .stack h4::before { content: ''; width: 7px; height: 7px; border-radius: 2px; background: var(--accent); }
  .stack ul { list-style: none; margin: 0; padding: 0; }
  .stack li { font-size: 0.9rem; color: var(--muted); padding: 6px 0; }

  .gallery { margin-top: 72px; }
  .gallery .kicker { margin-bottom: 16px; }

  @media (max-width: 820px) {
    .detail { padding-top: 100px; }
    .layout { grid-template-columns: 1fr; gap: 32px; }
    .stack { position: static; }
  }
</style>
