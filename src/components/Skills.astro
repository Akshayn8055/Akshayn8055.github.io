---
import { profile } from '../data/profile';
const groups = Object.entries(profile.skills).filter(([k]) => k !== 'Soft Skills');
---

<section class="section" id="skills">
  <div class="section-head">
    <h2 class="section-title">Technical Skills</h2>
  </div>
  <div class="cols">
    {groups.map(([name, items]) => (
      <div class="group">
        <h4>{name}</h4>
        <ul>{items.map((s: string) => <li>{s}</li>)}</ul>
      </div>
    ))}
  </div>
</section>

<style>
  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px 40px; }
  .group { padding-top: 18px; border-top: 1px solid var(--line); }
  .group h4 { display: flex; align-items: center; gap: 10px; font-size: 1rem; font-weight: 600; margin-bottom: 14px; }
  .group h4::before { content: ''; width: 7px; height: 7px; border-radius: 2px; background: var(--accent); flex: none; }
  .group ul { display: flex; flex-wrap: wrap; gap: 7px 16px; list-style: none; margin: 0; padding: 0; }
  .group li { font-size: 0.88rem; color: var(--muted); }
  @media (max-width: 900px) { .cols { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .cols { grid-template-columns: 1fr; } }
</style>
