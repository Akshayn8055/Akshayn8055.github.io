---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="section" id="contact">
  <p class="section-eyebrow">Get in touch</p>
  <h2 class="section-title">Sign my guestbook (email me!)</h2>
  <div class="neu-raised footer-card">
    <div>
      <h3>Let's build something autonomous.</h3>
      <p>Open to robotics, AI, and UAV engineering opportunities.</p>
    </div>
    <div class="footer-actions">
      <a class="neu-btn neu-btn-accent" href={`mailto:${profile.email}`}>✉ Email me</a>
      <a class="neu-btn" href={profile.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="neu-btn" href={profile.socials.github} target="_blank" rel="noopener">GitHub</a>
    </div>
  </div>
  <hr class="rainbow-hr" />
  <div class="badges">
    <span class="construction"><span class="blink">🚧</span> UNDER CONSTRUCTION (always) 🚧</span>
    <span class="counter">You are visitor #<b>000{year}</b></span>
  </div>
  <p class="fine-print">© {year} {profile.name}. Built with Astro, hosted on GitHub Pages.</p>
</footer>

<style>
  .footer-card { display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between; padding: 1.5rem; }
  .footer-actions { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .badges { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; align-items: center; margin-top: 1rem; }
  .construction { background: repeating-linear-gradient(45deg, #ffd800 0 12px, #000 12px 24px); color: #000; font-weight: 700; padding: 0.3rem; }
  .construction { background: #ffd800; border: 3px dashed #000; padding: 0.3rem 0.7rem; }
  .counter { background: #000; color: var(--lime); font-family: 'Courier New', monospace; padding: 0.3rem 0.7rem; box-shadow: var(--bevel-in); }
  .fine-print { text-align: center; margin-top: 1rem; font-size: 0.8rem; color: #fff; text-shadow: 1px 1px 0 #000; padding-bottom: 1.5rem; }
</style>
