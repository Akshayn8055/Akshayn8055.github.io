---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<section class="section contact" id="contact">
  <h2 class="title">Building something that has to <span>move on its own?</span></h2>
  <p class="sub">
    I'm looking for robotics, autonomy and UAV roles, research positions and collaborations. The quickest way to
    reach me is email.
  </p>
  <a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
  <div class="row">
    <a class="btn btn-solid" href={`mailto:${profile.email}`}>Email me</a>
    <a class="btn btn-ghost" href={profile.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    <a class="btn btn-ghost" href={profile.socials.github} target="_blank" rel="noopener">GitHub</a>
    <a class="btn btn-ghost" href={profile.resumeUrl} target="_blank" rel="noopener">Résumé</a>
  </div>
</section>

<footer class="footer">
  <span>© {year} {profile.name} · {profile.location}</span>
  <a class="top mono" href="#">Back to top ↑</a>
</footer>

<style>
  .contact { max-width: var(--maxw); }
  .title { font-size: clamp(1.9rem, 4.6vw, 2.8rem); line-height: 1.1; letter-spacing: -0.02em; max-width: 680px; }
  .title span { color: var(--accent); font-style: italic; }
  .sub { color: var(--muted); margin: 22px 0 26px; max-width: 540px; font-size: 1.05rem; }
  .email {
    display: inline-block;
    font-weight: 600;
    font-size: clamp(1.1rem, 2.6vw, 1.5rem);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgba(124, 198, 164, 0.35);
    text-underline-offset: 7px;
    margin-bottom: 30px;
    transition: text-decoration-color 0.2s;
  }
  .email:hover { text-decoration-color: var(--accent); }
  .row { display: flex; flex-wrap: wrap; gap: 12px; }

  .footer {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 40px clamp(20px, 5vw, 40px);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.85rem;
  }
  .top { color: var(--muted); transition: color 0.25s; }
  .top:hover { color: var(--accent); }
</style>
