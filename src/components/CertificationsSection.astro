---
import { getCollection } from 'astro:content';

const entries = await getCollection('certs');
const certs = entries.map((e) => ({ slug: e.id, ...e.data })).sort((a, b) => a.order - b.order);
---

<section class="section" id="certifications">
  <div class="section-head">
    <h2 class="section-title">Certifications &amp; Awards</h2>
  </div>

  <ol class="list">
    {certs.map((c) => (
      <li class="row">
        <span class="when mono">{c.date}</span>
        <div class="main">
          <h3>{c.title}</h3>
          <p class="issuer">{c.issuer}</p>
          {c.description && <p class="desc">{c.description}</p>}
        </div>
        {c.image && (
          <a class="thumb" href={c.pdf ?? c.image} target="_blank" rel="noopener" aria-label={`View ${c.title} certificate`}>
            <img src={c.image} alt="" loading="lazy" />
          </a>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .list { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: 150px 1fr 180px;
    gap: 26px;
    align-items: start;
    padding: 30px 0;
    border-top: 1px solid var(--line);
  }
  .row:last-child { border-bottom: 1px solid var(--line); }
  .when { color: var(--accent); font-size: 0.82rem; padding-top: 5px; }
  .main h3 { font-size: 1.28rem; line-height: 1.3; letter-spacing: -0.01em; }
  .issuer { color: var(--text); font-weight: 500; font-size: 0.9rem; margin: 6px 0 10px; opacity: 0.85; }
  .desc { color: var(--muted); font-size: 0.94rem; max-width: 68ch; }
  .thumb { display: block; border-radius: var(--radius-sm); overflow: hidden; background: #fff; border: 1px solid var(--line); transition: border-color 0.2s; }
  .thumb:hover { border-color: var(--accent); }
  .thumb img { width: 100%; aspect-ratio: 4/3; object-fit: contain; }

  @media (max-width: 860px) {
    .row { grid-template-columns: 1fr; gap: 10px; }
    .thumb { max-width: 220px; margin-top: 6px; }
  }
</style>
