---
import { getCollection } from 'astro:content';

const entries = await getCollection('certs');
const certs = entries
  .map((e) => ({ slug: e.id, ...e.data }))
  .sort((a, b) => a.order - b.order);
---

<section class="section" id="certifications">
  <p class="section-eyebrow">Recognition</p>
  <h2 class="section-title">Certifications & Achievements</h2>
  <div class="grid grid-3 cert-grid">
    {certs.map((c) => (
      <div class="neu-raised cert-card">
        {c.image && (
          <div class="cert-thumb">
            <img src={c.image} alt={c.title} loading="lazy" />
          </div>
        )}
        <div class="cert-body">
          <h3>{c.title}</h3>
          <p class="issuer">{c.issuer} · {c.date}</p>
          {c.description && <p class="desc">{c.description}</p>}
          <div class="cert-links">
            {c.pdf && (
              <a class="neu-btn neu-btn-accent small" href={c.pdf} target="_blank" rel="noopener">
                View certificate
              </a>
            )}
            {c.link && !c.pdf && (
              <a class="neu-btn small" href={c.link} target="_blank" rel="noopener">
                Learn more
              </a>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .cert-grid {
    margin-top: 2rem;
  }

  .cert-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0.6rem;
  }

  .cert-thumb {
    border-radius: calc(var(--radius-lg) - 0.6rem);
    overflow: hidden;
    aspect-ratio: 4/3;
    background: var(--shadow-dark);
  }

  .cert-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cert-body {
    padding: 1.4rem 1rem 1.1rem;
  }

  .cert-body h3 {
    font-size: 1.05rem;
    margin-bottom: 0.35rem;
  }

  .issuer {
    font-size: 0.82rem;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }

  .desc {
    font-size: 0.88rem;
    margin: 0 0 1rem;
  }

  .small {
    padding: 0.55rem 1.2rem;
    font-size: 0.85rem;
  }
</style>
