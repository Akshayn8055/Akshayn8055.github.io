---
interface Props {
  index: number;
  slug: string;
  title: string;
  tagline: string;
  dateRange: string;
  tags: string[];
  coverImage?: string;
  highlightVideo?: string;
}

const { index, slug, title, tagline, dateRange, tags, coverImage, highlightVideo } = Astro.props;
const id = String(index).padStart(2, '0');
---

<a class="panel card" href={`/projects/${slug}/`}>
  <div class="media">
    {highlightVideo ? (
      <video src={highlightVideo} poster={coverImage} muted loop playsinline autoplay preload="metadata"></video>
    ) : (
      <img src={coverImage} alt={title} loading="lazy" />
    )}
    <span class="label mono">M-{id}{highlightVideo && <span class="live"> · LIVE FEED</span>}</span>
  </div>
  <div class="body">
    <span class="date mono">{dateRange}</span>
    <h3>{title}</h3>
    <p>{tagline}</p>
    <div class="tags">
      {tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
    </div>
    <span class="more mono">Open log →</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .media { position: relative; aspect-ratio: 16/10; background: #000; overflow: hidden; }
  .media video,
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .label {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: #fff;
    background: rgba(0, 0, 0, 0.6);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }
  .live { color: #ff6b6b; }
  .body { display: flex; flex-direction: column; flex: 1; padding: 1.25rem 1.3rem 1.3rem; }
  .date { font-size: 0.7rem; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.06em; }
  .body h3 { font-size: 1.15rem; margin: 0.5rem 0 0; line-height: 1.25; }
  .body p { font-size: 0.9rem; margin: 0.6rem 0 1rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: auto; }
  .more { font-size: 0.75rem; color: var(--accent); margin-top: 1rem; }
</style>
