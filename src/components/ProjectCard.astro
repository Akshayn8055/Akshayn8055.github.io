---
interface Props {
  slug: string;
  title: string;
  tagline: string;
  dateRange: string;
  tags: string[];
  coverImage?: string;
  highlightVideo?: string;
}

const { slug, title, tagline, dateRange, tags, coverImage, highlightVideo } = Astro.props;
---

<a class="neu-raised card" href={`/projects/${slug}/`}>
  <div class="media">
    {highlightVideo ? (
      <video src={highlightVideo} poster={coverImage} muted loop playsinline autoplay preload="metadata"></video>
    ) : coverImage ? (
      <img src={coverImage} alt={title} loading="lazy" />
    ) : (
      <div class="placeholder"></div>
    )}
  </div>
  <div class="body">
    <div class="row">
      <h3>{title}</h3>
      <span class="date">{dateRange}</span>
    </div>
    <p>{tagline}</p>
    <div class="tags">
      {tags.slice(0, 4).map((t) => (
        <span class="chip">{t}</span>
      ))}
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 0.6rem;
    transition: transform 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
  }

  .media {
    border-radius: calc(var(--radius-lg) - 0.6rem);
    overflow: hidden;
    aspect-ratio: 16/9;
    background: var(--shadow-dark);
  }

  .media video,
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    background: var(--accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder::after {
    content: '';
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: 4px 4px 8px var(--shadow-dark), -4px -4px 8px var(--shadow-light);
  }

  .body {
    padding: 1.4rem 1rem 1.1rem;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
  }

  .row h3 {
    font-size: 1.15rem;
  }

  .date {
    font-size: 0.75rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .body p {
    margin: 0.5rem 0 0.9rem;
    font-size: 0.92rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
