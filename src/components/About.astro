---
import { profile } from '../data/profile';

const skillGroups = Object.entries(profile.skills).filter(([k]) => k !== 'Soft Skills' && k !== 'Tools');
const edu = profile.education[0];
---

<section class="section" id="about">
  <div class="section-head">
    <div>
      <p class="section-eyebrow">03 — Operator profile</p>
      <h2 class="section-title">About me</h2>
    </div>
  </div>

  <div class="about-grid">
    <div class="bio">
      <p class="bio-text">{profile.bio}</p>
      <div class="panel edu">
        <span class="mono k">Education</span>
        <strong>{edu.school}</strong>
        <span class="dim">{edu.degree}</span>
        <span class="mono date">{edu.dateRange}</span>
      </div>
    </div>

    <ol class="timeline">
      {profile.experience.map((exp) => (
        <li>
          <h3>{exp.org}</h3>
          <div class="roles">
            {exp.roles.map((r) => (
              <span class="role mono"><b>{r.title}</b> · {r.dateRange}</span>
            ))}
          </div>
          <ul>
            {exp.points.map((pt) => {
              const [head, ...rest] = pt.split(': ');
              return rest.length ? <li><strong>{head}:</strong> {rest.join(': ')}</li> : <li>{pt}</li>;
            })}
          </ul>
        </li>
      ))}
    </ol>
  </div>

  <div class="skills">
    {skillGroups.map(([group, items]) => (
      <div class="skill-row">
        <span class="mono group">{group}</span>
        <div class="items">
          {items.map((s: string) => <span class="tag">{s}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .about-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: 3.5rem; }
  .bio-text { font-size: 1.05rem; margin: 0 0 1.75rem; }
  .edu { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.25rem 1.4rem; }
  .k { font-size: 0.7rem; color: var(--accent); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.3rem; }
  .dim { color: var(--text-dim); font-size: 0.92rem; }
  .date { font-size: 0.75rem; color: var(--text-faint); margin-top: 0.3rem; }

  .timeline { list-style: none; margin: 0; padding: 0 0 0 1.5rem; border-left: 1px solid var(--line-2); }
  .timeline > li { position: relative; padding-bottom: 2.25rem; }
  .timeline > li:last-child { padding-bottom: 0; }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: calc(-1.5rem - 5px);
    top: 0.35rem;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg), 0 0 12px var(--accent);
  }
  .timeline h3 { font-size: 1.1rem; line-height: 1.3; }
  .roles { display: flex; flex-direction: column; gap: 0.25rem; margin: 0.6rem 0 0.8rem; }
  .role { font-size: 0.75rem; color: var(--text-faint); }
  .role b { color: var(--cyan); font-weight: 500; }
  .timeline ul { margin: 0; padding-left: 1.1rem; color: var(--text-dim); font-size: 0.92rem; line-height: 1.6; }
  .timeline ul li { margin-bottom: 0.5rem; }
  .timeline ul strong { color: var(--text); font-weight: 600; }

  .skills { margin-top: 3.5rem; border-top: 1px solid var(--line); }
  .skill-row { display: grid; grid-template-columns: 200px 1fr; gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .group { font-size: 0.75rem; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.08em; padding-top: 0.25rem; }
  .items { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  @media (max-width: 880px) {
    .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .skill-row { grid-template-columns: 1fr; gap: 0.6rem; }
  }
</style>
