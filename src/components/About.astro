---
import { profile } from '../data/profile';
const edu = profile.education[0];
---

<section class="section" id="about">
  <div class="section-head">
    <h2 class="section-title">About</h2>
  </div>

  <div class="grid">
    <figure class="media">
      <img src="/media/photos/ascend-gui-demo.webp" alt="Team WINGMEN demonstrating the ASCEND ground station at URSC, Bengaluru" loading="lazy" />
      <figcaption>
        <span class="k">Top 20</span>
        <span class="v">of ~590 teams<br />ISRO IRoC-U 2026</span>
      </figcaption>
    </figure>

    <div class="body">
      <p class="lead">
        I'm a robotics engineer from Bengaluru, trained in CS with a focus on AI &amp; ML, and I like building
        robots that have to work outside a simulator.
      </p>
      <p>
        Most of my time goes into autonomy for things that move: a drone that navigates with visual-inertial
        odometry instead of GPS, a LiDAR rover that maps a room it has never seen, and robot arms driven by
        vision and, more recently, LLM agents. I enjoy the whole loop, from fabricating carbon fibre frames and
        wiring a Jetson to tuning PID loops and writing the ROS nodes.
      </p>
      <p>
        I'm a Research Assistant at the <strong>Center of Excellence in Robotics &amp; Automation</strong> at
        Alliance University and Chief of the university's Robotics &amp; Automation Club, where I run
        workshops on UAVs and autonomous navigation.
      </p>
      <a class="honor" href="/media/certs/isro-irocu-cert.pdf" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="9" r="6"></circle><path d="M8.5 14 7 22l5-3 5 3-1.5-8"></path></svg>
        <span><strong>Top 20 National Finalist</strong>, ISRO Robotics Challenge (IRoC-U 2026), URSC Bengaluru <span class="mono verify">certificate ↗</span></span>
      </a>
      <p class="edu mono">{edu.degree} · {edu.dateRange}</p>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(36px, 6vw, 80px); align-items: start; }
  .media { position: relative; margin: 0; border-radius: var(--radius); overflow: hidden; background: var(--bg-2); }
  .media img { width: 100%; aspect-ratio: 4/5; object-fit: cover; object-position: 62% center; }
  .media figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(18, 18, 18, 0.72);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .k { font-weight: 600; font-size: 1.4rem; color: var(--accent); }
  .v { font-size: 0.76rem; color: var(--muted); line-height: 1.35; }

  .body p { color: var(--muted); margin-bottom: 20px; font-size: 1.04rem; }
  .body .lead { font-size: 1.22rem; color: var(--text); font-weight: 500; }
  .body strong { color: var(--text); font-weight: 600; }
  .honor {
    display: flex;
    align-items: center;
    gap: 11px;
    margin: 10px 0 20px;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--gold);
    font-size: 0.96rem;
    line-height: 1.55;
    transition: color 0.25s;
  }
  .honor:hover { color: var(--accent); }
  .honor svg { width: 22px; height: 22px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .honor strong { color: inherit; font-weight: 700; }
  .verify { font-size: 0.8em; opacity: 0.8; }
  .body .edu { font-size: 0.82rem; color: var(--faint); margin: 0; }

  @media (max-width: 820px) {
    .grid { grid-template-columns: 1fr; }
    .media img { aspect-ratio: 4/3; }
  }
</style>
