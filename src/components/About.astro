---
import { profile } from '../data/profile';

const allSkills = Object.values(profile.skills).flat();
---

<section class="section" id="about">
  <p class="section-eyebrow">About</p>
  <h2 class="section-title">Who I am</h2>

  <div class="about-grid">
    <div class="neu-raised about-bio">
      <p>{profile.bio}</p>
      <div class="edu-row">
        <div>
          <strong>{profile.education[0].school}</strong>
          <p class="dim">{profile.education[0].degree}</p>
        </div>
        <span class="chip">{profile.education[0].dateRange}</span>
      </div>
    </div>

    <div class="neu-raised timeline-card">
      <h3>Experience</h3>
      {profile.experience.map((exp) => (
        <div class="timeline-row">
          <strong>{exp.org}</strong>
          <div class="timeline-roles">
            {exp.roles.map((r) => (
              <span class="chip">{r.title} · {r.dateRange}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="skill-cloud">
    {allSkills.map((s: string) => (
      <span class="chip">{s}</span>
    ))}
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .about-bio,
  .timeline-card {
    padding: 2rem;
  }

  .about-bio h3,
  .timeline-card h3 {
    margin-bottom: 1.1rem;
    font-size: 1.05rem;
  }

  .edu-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .dim {
    color: var(--text-dim);
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
  }

  .timeline-row {
    margin-bottom: 1.25rem;
  }

  .timeline-row:last-child {
    margin-bottom: 0;
  }

  .timeline-row > strong {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 0.95rem;
  }

  .timeline-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
