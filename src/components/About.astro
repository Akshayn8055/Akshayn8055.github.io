---
import { profile } from '../data/profile';
---

<section class="section" id="about">
  <p class="section-eyebrow">About</p>
  <h2 class="section-title">Who I am</h2>
  <div class="about-grid">
    <div class="neu-raised about-bio">
      <p>{profile.bio}</p>
      <h3>Education</h3>
      {profile.education.map((e) => (
        <div class="edu-row">
          <div>
            <strong>{e.school}</strong>
            <p class="dim">{e.degree}</p>
          </div>
          <span class="chip">{e.dateRange}</span>
        </div>
      ))}

      <h3>Languages</h3>
      <div class="skill-chips">
        {profile.languages.map((l: string) => (
          <span class="chip">{l}</span>
        ))}
      </div>

      <h3>Hobbies</h3>
      <div class="skill-chips">
        {profile.hobbies.map((h: string) => (
          <span class="chip">{h}</span>
        ))}
      </div>
    </div>
    <div class="skills-col">
      {Object.entries(profile.skills).map(([group, items]) => (
        <div class="neu-flat skill-card">
          <h4>{group}</h4>
          <div class="skill-chips">
            {items.map((s: string) => (
              <span class="chip">{s}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="neu-raised experience-card">
    <h3>Experience & Leadership</h3>
    {profile.experience.map((exp) => (
      <div class="exp-row">
        <div class="exp-header">
          <strong>{exp.org}</strong>
          <div class="exp-roles">
            {exp.roles.map((r) => (
              <span class="chip">{r.title} · {r.dateRange}</span>
            ))}
          </div>
        </div>
        <ul>
          {exp.points.map((p) => (
            <li>{p}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.75rem;
    margin-top: 2rem;
  }

  .about-bio {
    padding: 2.25rem;
  }

  .about-bio h3 {
    margin-top: 1.75rem;
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .edu-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .dim {
    color: var(--text-dim);
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
  }

  .skills-col {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .skill-card {
    padding: 1.25rem 1.4rem;
  }

  .skill-card h4 {
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .skill-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .experience-card {
    margin-top: 1.75rem;
    padding: 2.25rem;
  }

  .experience-card h3 {
    margin-bottom: 1.5rem;
  }

  .exp-row {
    margin-bottom: 1.5rem;
  }

  .exp-row:last-child {
    margin-bottom: 0;
  }

  .exp-header {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }

  .exp-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .exp-row ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text-dim);
  }

  .exp-row li {
    margin-bottom: 0.4rem;
    line-height: 1.6;
  }

  @media (max-width: 820px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
