---
import { getCollection } from 'astro:content';

const entries = await getCollection('projects');
const projects = entries.map((e) => ({ slug: e.id, ...e.data })).sort((a, b) => a.order - b.order);
const flagship = projects.find((p) => p.slug === 'ascend-uav');
const rest = projects.filter((p) => p.slug !== 'ascend-uav');
---

<section class="section" id="projects">
  <div class="section-head">
    <h2 class="section-title">Projects</h2>
    <p class="section-sub">Things I've designed, built and tested on real hardware, starting with the one I'm proudest of.</p>
  </div>

  {flagship && (
    <article class="feature">
      <a class="feature-media" href={`/projects/${flagship.slug}/`}>
        <img src="/media/photos/ascend-ground-rig.webp" alt="The ASCEND UAV on its landing and charging pad" loading="lazy" />
        <span class="feature-status mono">Final field round · URSC, Jul 2026</span>
      </a>
      <div class="feature-body">
        <p class="kicker">Flagship · Team Lead · {flagship.dateRange}</p>
        <h3><a href={`/projects/${flagship.slug}/`}>ASCEND: an autonomous UAV for ISRO's Robotics Challenge</a></h3>
        <p class="byline">Team WINGMEN, Alliance University</p>
        <p class="desc">
          A drone built from scratch to fly a full mission with no GPS. It localises with an Intel RealSense D455
          using visual-inertial odometry, detects features on the ground, and lands itself on a charging pad. The
          autonomy stack runs on a Jetson Orin Nano talking to ArduCopter through MAVROS, on a carbon fibre frame we
          fabricated ourselves.
        </p>
        <ul class="points">
          <li>Selected as 1 of 20 national finalists from ~590 teams</li>
          <li>Flew the final round for ISRO scientists at URSC, Bengaluru</li>
        </ul>
        <div class="links">
          <a class="link-arrow" href={`/projects/${flagship.slug}/`}>Case study →</a>
          <a class="link-arrow" href="https://youtu.be/rNrGeEh-YAY" target="_blank" rel="noopener">Flight video →</a>
          <a class="link-arrow" href={flagship.links.report} target="_blank" rel="noopener">Design report →</a>
        </div>
      </div>
    </article>
  )}

  <ol class="list">
    {rest.map((p) => (
      <li class="row">
        <span class="when mono">{p.dateRange}</span>
        <div class="main">
          <h3><a href={`/projects/${p.slug}/`}>{p.title}</a></h3>
          <p>{p.tagline}</p>
          <div class="tags">{p.tags.slice(0, 4).map((t) => <span>{t}</span>)}</div>
          {p.highlightVideo && (
            <a class="clip" href={`/projects/${p.slug}/`} aria-label={`${p.title} demo`}>
              <video src={p.highlightVideo} poster={p.coverImage} muted loop playsinline autoplay preload="metadata"></video>
            </a>
          )}
        </div>
        <a class="link-arrow more" href={`/projects/${p.slug}/`}>Details →</a>
      </li>
    ))}
  </ol>
</section>

<style>
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(30px, 5vw, 68px);
    align-items: center;
    padding: clamp(24px, 3vw, 38px) 0;
    border-top: 1px solid var(--line);
  }
  .feature-media { position: relative; display: block; aspect-ratio: 3/2; overflow: hidden; border-radius: var(--radius); background: var(--bg-2); }
  .feature-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .feature-media:hover img { transform: scale(1.03); }
  .feature-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(13, 14, 19, 0.6)); }
  .feature-status {
    position: absolute;
    left: 18px;
    bottom: 16px;
    z-index: 1;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }
  .feature-body .kicker { margin-bottom: 12px; }
  .feature-body h3 { font-size: clamp(1.55rem, 2.9vw, 2.15rem); line-height: 1.2; letter-spacing: -0.4px; }
  .feature-body h3 a:hover { color: var(--accent); }
  .byline { color: var(--faint); font-size: 0.9rem; margin: 8px 0 16px; }
  .desc { color: var(--muted); font-size: 1rem; }
  .points { margin: 16px 0 22px; padding: 0; list-style: none; }
  .points li { position: relative; padding-left: 18px; color: var(--text); font-size: 0.95rem; margin-bottom: 6px; }
  .points li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 6px; height: 6px; border-radius: 2px; background: var(--accent); }
  .links { display: flex; flex-wrap: wrap; gap: 8px 22px; }

  .list { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: 150px 1fr auto;
    gap: 26px;
    align-items: start;
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }
  .row:last-child { border-bottom: 1px solid var(--line); }
  .when { color: var(--accent); font-size: 0.82rem; padding-top: 5px; }
  .main h3 { font-size: 1.36rem; line-height: 1.25; letter-spacing: -0.01em; margin-bottom: 8px; }
  .main h3 a:hover { color: var(--accent); }
  .main p { color: var(--muted); font-size: 0.96rem; margin-bottom: 12px; max-width: 68ch; }
  .clip { display: block; margin-top: 18px; max-width: 520px; aspect-ratio: 16/9; border-radius: var(--radius-sm); overflow: hidden; background: #000; }
  .clip video { width: 100%; height: 100%; object-fit: cover; }
  .more { padding-top: 5px; }

  @media (max-width: 860px) {
    .feature { grid-template-columns: 1fr; }
    .row { grid-template-columns: 1fr; gap: 10px; }
    .more { padding-top: 0; }
  }
</style>
