---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const entries = await getCollection('projects');
const projects = entries
  .map((e) => ({ slug: e.id, ...e.data }))
  .filter((p) => p.slug !== 'ascend-uav') // shown in the Flagship section
  .sort((a, b) => a.order - b.order);

const withMedia = projects.filter((p) => p.highlightVideo || p.coverImage);
const others = projects.filter((p) => !p.highlightVideo && !p.coverImage);
---

<section class="section" id="projects">
  <div class="section-head">
    <div>
      <p class="section-eyebrow">02 — Mission log</p>
      <h2 class="section-title">More things I've built</h2>
    </div>
    <span class="section-meta">{projects.length} ENTRIES</span>
  </div>

  <div class="grid">
    {withMedia.map((p, i) => (
      <ProjectCard
        index={i + 2}
        slug={p.slug}
        title={p.title}
        tagline={p.tagline}
        dateRange={p.dateRange}
        tags={p.tags}
        coverImage={p.coverImage}
        highlightVideo={p.highlightVideo}
      />
    ))}
  </div>

  {others.length > 0 && (
    <div class="others">
      <p class="others-head mono">Side projects</p>
      {others.map((p) => (
        <a class="other" href={`/projects/${p.slug}/`}>
          <div>
            <h3>{p.title}</h3>
            <p>{p.tagline}</p>
          </div>
          <div class="other-tags">
            {p.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
          </div>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
  .others { margin-top: 3rem; border-top: 1px solid var(--line); }
  .others-head {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 1.25rem 0 0.25rem;
  }
  .other {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
    transition: padding 0.2s ease;
  }
  .other:hover { padding-left: 0.6rem; }
  .other h3 { font-size: 1.1rem; }
  .other p { margin: 0.3rem 0 0; font-size: 0.92rem; }
  .other-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; justify-content: flex-end; }
  .arrow { color: var(--accent); font-size: 1.2rem; }

  @media (max-width: 960px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
    .other { grid-template-columns: 1fr auto; }
    .other-tags { display: none; }
  }
</style>
