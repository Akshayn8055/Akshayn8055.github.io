---
import { profile } from '../data/profile';
---

<section class="hero section">
  <div class="hero-copy">
    <p class="section-eyebrow">{profile.role}</p>
    <h1 class="hero-title">{profile.name}</h1>
    <p class="hero-tagline">{profile.tagline}</p>
    <div class="hero-actions">
      <a class="neu-btn neu-btn-accent" href="#projects">See my work</a>
      <a class="neu-btn" href={profile.resumeUrl} target="_blank" rel="noopener">Download résumé</a>
    </div>
    <div class="hero-stats">
      <div class="neu-flat stat">
        <strong>Top 20</strong>
        <span>ISRO IRoC-U 2026, national finalist</span>
      </div>
      <div class="neu-flat stat">
        <strong>Grand Prize</strong>
        <span>Cyberwave Builders — Physical AI</span>
      </div>
      <div class="neu-flat stat">
        <strong>4-member team lead</strong>
        <span>ASCEND autonomous UAV</span>
      </div>
    </div>
  </div>
  <div class="hero-portrait neu-raised" aria-hidden="true">
    <div class="monogram neu-pressed">AN</div>
    <svg class="orbit" viewBox="0 0 200 200" fill="none">
      <circle cx="100" cy="100" r="86" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 10" />
    </svg>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: center;
    padding-top: 3rem;
  }

  .hero-title {
    font-size: clamp(2.4rem, 6vw, 3.6rem);
    margin: 0.4rem 0 1rem;
  }

  .hero-tagline {
    font-size: 1.1rem;
    max-width: 480px;
  }

  .hero-actions {
    display: flex;
    gap: 0.85rem;
    margin: 1.75rem 0 2.5rem;
    flex-wrap: wrap;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .stat {
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat strong {
    font-size: 1rem;
    color: var(--accent);
  }

  .stat span {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .hero-portrait {
    aspect-ratio: 1;
    padding: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .monogram {
    width: 62%;
    height: 62%;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    color: var(--accent);
    letter-spacing: -0.02em;
  }

  .orbit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--shadow-dark);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-tagline {
      max-width: 100%;
      margin-inline: auto;
    }
    .hero-actions,
    .hero-stats {
      justify-content: center;
    }
    .hero-portrait {
      max-width: 320px;
      margin: 0 auto;
    }
  }

  @media (max-width: 560px) {
    .hero-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
