---
import { profile } from '../data/profile';
---

<section class="hero section">
  <div class="hero-copy">
    <p class="section-eyebrow">{profile.role}</p>
    <h1 class="hero-title">{profile.name}</h1>
    <p class="hero-tagline">{profile.tagline}</p>
    <span class="chip">★ Top 20 Nationally · ISRO IRoC-U 2026</span>
    <div class="hero-actions">
      <a class="neu-btn neu-btn-accent" href="#projects">See my work</a>
      <a class="neu-btn" href={profile.resumeUrl} target="_blank" rel="noopener">Download résumé</a>
    </div>
  </div>
  <div class="hero-portrait neu-raised">
    <img src="/media/photos/drone.webp" alt="ASCEND autonomous UAV in flight" />
  </div>
</section>

<style>
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; align-items: center; padding-top: 3rem; }
  .hero-title {
    font-size: clamp(2.6rem, 7vw, 4rem); margin: 0.3rem 0 1rem; font-weight: 700;
    color: #0a4a7a; text-shadow: 0 2px 0 #fff, 0 6px 18px rgba(255, 255, 255, 0.7);
  }
  .hero-tagline { font-size: 1.1rem; max-width: 480px; margin-bottom: 1.25rem; color: #0f3a58; }
  .hero-actions { display: flex; gap: 0.85rem; margin-top: 1.75rem; flex-wrap: wrap; }
  .hero-portrait { aspect-ratio: 16/9; padding: 0.55rem; overflow: hidden; }
  .hero-portrait img { width: 100%; height: 100%; object-fit: cover; border-radius: calc(var(--radius-lg) - 0.55rem); }

  @media (max-width: 820px) {
    .hero { grid-template-columns: 1fr; text-align: center; gap: 2rem; }
    .hero-tagline { max-width: 100%; margin-inline: auto; }
    .hero-actions { justify-content: center; }
    .hero-portrait { max-width: 440px; margin: 0 auto; }
  }
  @media (max-width: 480px) {
    .hero-actions { flex-direction: column; }
    .hero-actions .neu-btn { width: 100%; text-align: center; }
  }
</style>
