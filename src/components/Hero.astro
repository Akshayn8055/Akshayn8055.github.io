---
import { profile } from '../data/profile';
---

<section class="hero">
  <div class="photo" aria-hidden="true">
    <img src="/media/photos/drone.webp" alt="" />
  </div>
  <div class="scrim" aria-hidden="true"></div>

  <div class="inner">
    <p class="status"><span class="pulse"></span>Open to robotics &amp; AI roles · {profile.location}</p>
    <h1 class="title">{profile.name}</h1>
    <p class="lede">
      Robotics &amp; AI engineer. I led Team WINGMEN to the national finals of <strong>ISRO's Robotics Challenge (IRoC-U 2026)</strong>: top 20 of ~590 teams, with a drone that <em>flies and lands without GPS</em>.
      These days I build GPS-denied rovers at Alliance University's robotics lab.
    </p>
    <div class="cta">
      <a class="btn btn-solid" href="#projects">See my work</a>
      <a class="btn btn-ghost" href={profile.resumeUrl} target="_blank" rel="noopener">Résumé (PDF)</a>
    </div>
    <p class="meta mono">
      <a href={profile.socials.github} target="_blank" rel="noopener">GitHub</a>
      <span>/</span>
      <a href={profile.socials.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <span>/</span>
      <a href={`mailto:${profile.email}`}>Email</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 120px clamp(20px, 5vw, 56px) 80px;
    overflow: hidden;
    background: #111;
  }
  .photo { position: absolute; inset: 0 0 0 28%; z-index: 0; }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% center;
    filter: brightness(0.7) contrast(1.1) saturate(0.85);
  }
  .scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, #111 0%, #111 28%, rgba(17, 17, 17, 0.75) 40%, rgba(17, 17, 17, 0.15) 65%, transparent 80%),
      linear-gradient(0deg, var(--bg) 0%, rgba(18, 18, 18, 0.5) 14%, transparent 40%),
      linear-gradient(180deg, rgba(17, 17, 17, 0.7) 0%, transparent 22%);
  }
  .inner { position: relative; z-index: 2; max-width: 760px; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 30px;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--muted);
  }
  .pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); animation: strobe 2.4s steps(1, end) infinite; }
  @keyframes strobe {
    0%, 9% { opacity: 1; }
    4%, 13%, 100% { opacity: 0.25; }
  }
  .title {
    font-weight: 500;
    letter-spacing: -0.025em;
    font-size: clamp(3rem, 8vw, 5.6rem);
    line-height: 1;
    margin-bottom: 28px;
  }
  .lede { max-width: 600px; font-size: clamp(1rem, 2vw, 1.18rem); color: var(--muted); margin-bottom: 34px; }
  .lede strong { color: var(--text); font-weight: 600; }
  .lede em { font-style: normal; color: var(--accent); }
  .cta { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 34px; }
  .meta { display: flex; flex-wrap: wrap; gap: 12px; font-size: 0.85rem; color: var(--faint); }
  .meta a { color: var(--muted); transition: color 0.25s; }
  .meta a:hover { color: var(--accent); }

  @media (max-width: 720px) {
    .hero { align-items: flex-end; padding-bottom: 56px; }
    .photo { inset: 0 0 45% 0; }
    .photo img { object-position: center; }
    .scrim {
      background: linear-gradient(0deg, var(--bg) 0%, var(--bg) 46%, rgba(18, 18, 18, 0.6) 62%, transparent 85%),
        linear-gradient(180deg, rgba(17, 17, 17, 0.7) 0%, transparent 20%);
    }
  }
</style>
