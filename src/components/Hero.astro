---
import { profile } from '../data/profile';
---

<section class="hero section">
  <div class="win neu-raised">
    <div class="titlebar">C:\HOME\index.htm<span class="ctl">_ □ ✕</span></div>
    <div class="win-body">
      <div class="hero-copy">
        <p class="eyebrow">~*~ {profile.role} ~*~</p>
        <h1 class="hero-title">Welcome to {profile.name}'s Homepage!</h1>
        <p class="hero-tagline">{profile.tagline}</p>
        <span class="chip"><span class="blink">★ NEW!</span>&nbsp;Top 20 Nationally · ISRO IRoC-U 2026</span>
        <div class="hero-actions">
          <a class="neu-btn neu-btn-accent" href="#projects">See my work</a>
          <a class="neu-btn" href={profile.resumeUrl} target="_blank" rel="noopener">Download résumé</a>
        </div>
      </div>
      <div class="hero-portrait neu-pressed">
        <img src="/media/photos/drone.webp" alt="ASCEND autonomous UAV in flight" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero { margin-top: 1.5rem; }
  .titlebar {
    background: linear-gradient(90deg, var(--title-a), var(--title-b));
    color: #fff; font-weight: 700; font-size: 0.85rem;
    padding: 0.25rem 0.5rem; margin: 3px; display: flex; justify-content: space-between;
  }
  .ctl { color: #000; background: var(--bg); padding: 0 0.35rem; letter-spacing: 0.15em; box-shadow: var(--bevel-out); }
  .win-body {
    display: grid; grid-template-columns: 1.3fr 1fr; gap: 1.5rem;
    align-items: center; padding: 1.25rem;
  }
  .eyebrow { font-family: 'Courier New', monospace; color: var(--hot); font-weight: 700; margin: 0 0 0.4rem; }
  .hero-title {
    font-size: clamp(1.7rem, 4.5vw, 2.6rem); margin: 0 0 0.8rem;
    background: linear-gradient(90deg, #ff0080, #ff8c00, #00a000, #0050ff, #a000ff);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .hero-tagline { font-size: 1rem; margin-bottom: 1rem; }
  .hero-actions { display: flex; gap: 0.75rem; margin-top: 1.25rem; flex-wrap: wrap; }
  .hero-portrait { aspect-ratio: 16/9; padding: 4px; overflow: hidden; background: #000; }
  .hero-portrait img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 820px) {
    .win-body { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .hero-actions { flex-direction: column; }
    .hero-actions .neu-btn { width: 100%; text-align: center; }
  }
</style>
