---
import { profile } from '../data/profile';

const stats = [
  { value: 'Top 20', label: 'of ~590 teams · ISRO IRoC-U 2026' },
  { value: 'Team Lead', label: 'ASCEND autonomous UAV' },
  { value: '3 domains', label: 'aerial · ground · manipulation' },
  { value: 'RA', label: 'COE Robotics & Automation' },
];
---

<section class="hero section">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="status">Open to opportunities · {profile.location}</p>
      <h1 class="hero-title">
        I build robots<br />that <span class="hl">find their<br />own way.</span>
      </h1>
      <p class="hero-tagline">
        {profile.name} — {profile.role}. GPS-denied UAVs, SLAM rovers and physical AI agents, designed,
        built and tested end to end.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#flagship">View flagship project →</a>
        <a class="btn" href="#projects">All projects</a>
      </div>
    </div>

    <a class="hero-media hud" href="/projects/ascend-uav/" aria-label="ASCEND UAV project">
      <img src="/media/photos/ascend-flight-test.webp" alt="ASCEND autonomous UAV during a flight test" />
      <div class="overlay mono">
        <span class="tl">CAM_01 // ASCEND</span>
        <span class="tr"><span class="rec"></span>REC</span>
        <span class="bl">VIO · GPS-DENIED · AUTONOMOUS</span>
      </div>
      <div class="reticle" aria-hidden="true"></div>
    </a>
  </div>

  <dl class="stats">
    {stats.map((s) => (
      <div class="stat">
        <dt>{s.value}</dt>
        <dd>{s.label}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .hero { padding-top: 4.5rem; padding-bottom: 3rem; }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 3rem; align-items: center; }
  .hero-title {
    font-size: clamp(2.4rem, 4.9vw, 4rem);
    font-weight: 700;
    margin: 1.25rem 0 1.4rem;
    letter-spacing: -0.035em;
  }
  .hl { color: var(--accent); }
  .hero-tagline { font-size: 1.12rem; max-width: 520px; margin: 0; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  .hero-media { display: block; aspect-ratio: 4/3; border-radius: var(--radius-md); }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
    filter: saturate(0.9) contrast(1.05);
  }
  .overlay {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.45), transparent 30%, transparent 65%, rgba(0, 0, 0, 0.6));
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: #fff;
  }
  .overlay span { position: absolute; }
  .overlay .rec { position: static; }
  .tl { top: 0.9rem; left: 1rem; }
  .tr { top: 0.9rem; right: 1rem; display: flex; align-items: center; gap: 0.4rem; color: #ff6b6b; }
  .bl { bottom: 0.9rem; left: 1rem; color: var(--cyan); }
  .rec { width: 8px; height: 8px; border-radius: 50%; background: #ff3b3b; animation: pulse 1.2s infinite; }
  .reticle {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 64px;
    height: 64px;
    translate: -50% -50%;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 50%;
    transition: transform 0.3s ease;
  }
  .reticle::before,
  .reticle::after { content: ''; position: absolute; background: rgba(255, 255, 255, 0.45); }
  .reticle::before { left: 50%; top: -12px; bottom: -12px; width: 1px; }
  .reticle::after { top: 50%; left: -12px; right: -12px; height: 1px; }
  .hero-media:hover .reticle { transform: scale(1.25); }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 4rem 0 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: rgba(15, 20, 27, 0.6);
  }
  .stat { padding: 1.3rem 1.4rem; border-left: 1px solid var(--line); }
  .stat:first-child { border-left: 0; }
  .stat dt { font-size: 1.5rem; font-weight: 700; color: var(--text); }
  .stat:first-child dt { color: var(--accent); }
  .stat dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    line-height: 1.5;
  }

  @media (max-width: 880px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .stats { grid-template-columns: repeat(2, 1fr); }
    .stat:nth-child(3) { border-left: 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 480px) {
    .hero { padding-top: 2.5rem; }
    .hero-actions .btn { flex: 1 1 100%; justify-content: center; }
  }
</style>
