---
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#certifications', label: 'Certifications' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="nav-wrap">
  <nav class="neu-raised nav">
    <a href="/" class="brand">Akshay N</a>
    <div class="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </nav>
</header>

<style>
  .nav-wrap { position: sticky; top: 0.9rem; z-index: 40; display: flex; justify-content: center; padding: 0 1rem; margin-top: 0.9rem; }
  .nav { width: 100%; max-width: 800px; display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 1.5rem; border-radius: var(--radius-pill); }
  .brand { font-weight: 700; color: #0a4a7a; text-shadow: 0 1px 0 #fff; }
  .links { display: flex; gap: 1.4rem; font-weight: 600; font-size: 0.92rem; }
  .links a { color: var(--text-dim); }
  .links a:hover { color: var(--accent); }
  @media (max-width: 560px) { .links { gap: 0.6rem 1rem; font-size: 0.78rem; } .nav { padding: 0.7rem 1.1rem; border-radius: var(--radius-lg); } }
  @media (max-width: 460px) { .nav { flex-direction: column; gap: 0.6rem; } .links { justify-content: center; flex-wrap: wrap; } }
</style>
