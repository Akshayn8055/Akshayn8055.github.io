---
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#certifications', label: 'Certifications' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="nav-wrap">
  <nav class="neu-raised-sm nav">
    <a href="/" class="brand">Akshay N</a>
    <div class="links">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .nav-wrap {
    position: sticky;
    top: 1rem;
    z-index: 40;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
  }

  .nav {
    width: 100%;
    max-width: 780px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.5rem;
  }

  .brand {
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--text-dim);
  }

  .links a:hover {
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .links {
      gap: 0.7rem 1rem;
      font-size: 0.78rem;
    }
    .nav {
      padding: 0.75rem 1.1rem;
    }
  }

  @media (max-width: 460px) {
    .nav {
      flex-direction: column;
      gap: 0.75rem;
    }
    .links {
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>
