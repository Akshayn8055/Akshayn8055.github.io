---
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#certifications', label: 'Certs' },
  { href: '/#contact', label: 'Contact' },
];
---

<div class="marquee neu-pressed" aria-hidden="true">
  <div class="marquee-inner">
    ★ ★ ★ WELCOME TO MY WEBSITE ★ ★ ★ Best viewed in Netscape Navigator at 800x600 ★ ★ ★ Robotics · UAVs · Physical AI ★ ★ ★ Please sign my guestbook! ★ ★ ★
  </div>
</div>

<header class="taskbar">
  <a href="/" class="start neu-btn">⊞ <b>Akshay N</b></a>
  <nav class="links">
    {links.map((l) => <a class="neu-btn" href={l.href}>{l.label}</a>)}
  </nav>
</header>

<style>
  .marquee { overflow: hidden; background: #000; color: var(--lime); font-family: 'Courier New', monospace; font-weight: 700; white-space: nowrap; padding: 0.3rem 0; }
  .marquee-inner { display: inline-block; padding-left: 100%; animation: scroll 25s linear infinite; }
  @keyframes scroll { to { transform: translateX(-100%); } }

  .taskbar {
    position: sticky; top: 0; z-index: 40;
    display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;
    background: var(--bg); padding: 0.3rem 0.5rem;
    box-shadow: inset 0 1px 0 var(--win-light), 0 2px 0 #000;
  }
  .start { color: #000; text-decoration: none; padding: 0.35rem 0.8rem; }
  .links { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .links a { padding: 0.35rem 0.8rem; font-weight: 400; color: #000; text-decoration: none; }
  @media (max-width: 480px) { .links a { padding: 0.3rem 0.55rem; font-size: 0.8rem; } }
</style>
